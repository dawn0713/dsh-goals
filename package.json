{
  "name": "dsh-personal-goals",
  "version": "0.2.3-dsh.0.2.1",
  "description": "Goals 个人目标与条件追踪；支持 DSH 0.2.1-alpha.1 / alpha.2 / rc.2 Web",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1 || ~4.0.5",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-schedule": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1 || ~3.18.5"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/dsh-schedule": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "zod"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawn0713/dsh-goals.git"
  },
  "homepage": "https://github.com/dawn0713/dsh-goals#readme",
  "bugs": {
    "url": "https://github.com/dawn0713/dsh-goals/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "goals",
    "ideas",
    "personal-goals"
  ]
}
